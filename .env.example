# Infra-only env vars. Domain bot settings (token, timezone, …) live in the DB.
# SQLite example (project-root DB):
DATABASE_URL=sqlite:///adhoc_history.sqlite3

# Set to DEBUG temporarily to trace Telegram polling/update/send timings.
ADHOC_LOG_LEVEL=INFO

# postgres/postgresql DATABASE_URL values are not supported by the current
# Telegram bot storage layer yet.
